# ARM64 FMLA instruction (NEON 4-lane 32-bit floating-point Multiply-Add to accumulator)
- go: MulAdd
  goarch: arm64
  asm: VFMLA
  arrangement: "4S"
  cpuFeature: NEON
  commutative: true
  inVariant: []
  documentation: !string |-
    // NAME multiplies n by m and adds the product to the accumulator
  in:
  - class: vreg
    go: Float32x4
    name: accumulator
    base: float
    elemBits: 32
    bits: 128
    lanes: 4
    asmPos: 0
  - class: vreg
    go: Float32x4
    name: n
    base: float
    elemBits: 32
    bits: 128
    lanes: 4
    asmPos: 1
  - class: vreg
    go: Float32x4
    name: m
    base: float
    elemBits: 32
    bits: 128
    lanes: 4
    asmPos: 2
  out:
  - class: vreg
    go: Float32x4
    base: float
    elemBits: 32
    bits: 128
    lanes: 4
    asmPos: 0

