# ARM64 TBL (NEON Table vector Lookup of 16 lanes (from single source))
- go: Permute
  goarch: arm64
  asm: VTBL
  arrangement: "16B"
  cpuFeature: NEON
  commutative: false
  inVariant: []
  documentation: !string |-
    // NAME performs a full permutation of source using indices:
    // result := {source[indices[0]], source[indices[1]], ..., source[indices[n]]}
    // the lanes with indices out of range are set to zero.
  in:
  - class: vreg
    name: source
    go: Uint8x16
    base: uint
    elemBits: 8
    bits: 128
    lanes: 16
    listNumber: 0
    asmPos: 1
  - class: vreg
    name: indices
    go: Uint8x16
    base: uint
    elemBits: 8
    bits: 128
    lanes: 16
    asmPos: 2
  out:
  - class: vreg
    go: Uint8x16
    base: uint
    elemBits: 8
    bits: 128
    lanes: 16
    asmPos: 0

# ARM64 TBX (NEON Table vector Lookup of 16 lanes (from single source))
- go: PermuteX
  goarch: arm64
  asm: VTBX
  arrangement: "16B"
  cpuFeature: NEON
  commutative: false
  inVariant: []
  documentation: !string |-
    // NAME performs a full permutation of source using indices:
    // result := {source[indices[0]], source[indices[1]], ..., source[indices[n]]}
    // the lanes with indices out of range have values from original.
  in:
  - class: vreg
    name: original
    go: Uint8x16
    base: uint
    elemBits: 8
    bits: 128
    lanes: 16
    asmPos: 0
  - class: vreg
    name: source
    go: Uint8x16
    base: uint
    elemBits: 8
    bits: 128
    lanes: 16
    listNumber: 0
    asmPos: 1
  - class: vreg
    name: indices
    go: Uint8x16
    base: uint
    elemBits: 8
    bits: 128
    lanes: 16
    asmPos: 2
  out:
  - class: vreg
    go: Uint8x16
    base: uint
    elemBits: 8
    bits: 128
    lanes: 16
    asmPos: 0

# ARM64 BIT (NEON Bitwise Insert if True)
- go: Blend
  goarch: arm64
  asm: VBIT
  arrangement: "16B"
  cpuFeature: NEON
  commutative: false
  inVariant: []
  documentation: !string |-
    // NAME inserts each bit from newbits into result where corresponding bit of mask is 1,
    // otherwise it leaves bit from original.
    // The compiler is free to choose any of VBIT, VBIF or VBSL to do the work.
  in:
  - class: vreg
    name: original
    go: Uint8x16
    base: uint
    elemBits: 8
    bits: 128
    lanes: 16
    asmPos: 0
  - class: vreg
    name: newbits
    go: Uint8x16
    base: uint
    elemBits: 8
    bits: 128
    lanes: 16
    asmPos: 1
  - class: vreg
    name: mask
    go: Uint8x16
    base: uint
    elemBits: 8
    bits: 128
    lanes: 16
    asmPos: 2
  out:
  - class: vreg
    go: Uint8x16
    base: uint
    elemBits: 8
    bits: 128
    lanes: 16
    asmPos: 0

# ARM64 CNT instruction (NEON 16-lane Population Count per byte)
- go: OnesCount
  goarch: arm64
  asm: VCNT
  arrangement: "16B"
  cpuFeature: NEON
  commutative: true
  inVariant: []
  documentation: !string |-
    // NAME counts bits set to 1 in each byte.
  in:
  - class: vreg
    go: Uint8x16
    base: uint
    elemBits: 8
    bits: 128
    lanes: 16
    asmPos: 1
  out:
  - class: vreg
    go: Uint8x16
    base: uint
    elemBits: 8
    bits: 128
    lanes: 16
    asmPos: 0

# ARM64 EXT (NEON Extract vector from pair of vectors)
- go: Extract
  goarch: arm64
  asm: VEXT
  arrangement: "16B"
  cpuFeature: NEON
  commutative: false
  inVariant: []
  documentation: !string |-
    // NAME extracts the lowest vector elements from the second argument and
    // the highest vector elements from the first. The constant index value
    // specifies the lowest vector element to extract from the first source,
    // and consecutive elements are extracted from the first, then second
    // until the result vector is filled.
  in:
  - class: vreg
    name: first
    go: Uint8x16
    base: uint
    elemBits: 8
    bits: 128
    lanes: 16
    asmPos: 1
  - class: vreg
    name: second
    go: Uint8x16
    base: uint
    elemBits: 8
    bits: 128
    lanes: 16
    asmPos: 2
  - class: immediate
    bits: 8
    immOffset: 0
    go: Immediate
    asmPos: 3
  out:
  - class: vreg
    go: Uint8x16
    base: uint
    elemBits: 8
    bits: 128
    lanes: 16
    asmPos: 0
