+// simdRegListOffset converts a sequence of regCnt registers starting from
+// the v's SSA register into appropriate ARM64 register list.
+// Need to be consistent with ARM64RegisterListOffset.
+func simdRegListOffset(v *ssa.Value, regCnt, arrangement int16) int64 {
+       regNum := simdRegNum(v) + arm64.REG_V0
+       offset := int64(regNum)
+       switch regCnt {
+       case 1:
+               offset |= 0x7 << 12
+       case 2:
+               offset |= 0xa << 12
+       case 3:
+               offset |= 0x6 << 12
+       case 4:
+               offset |= 0x2 << 12
+       }
+       offset |= int64(arrangement << 5)
+       offset |= 1 << 60
+       return offset
 }
