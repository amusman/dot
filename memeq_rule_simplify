+
+func chunk(size int64, returnRight bool, typ *Types) *types.Type {
+       if size > 16 {
+               return nil
+       }
+       half := size >> 1
+       for left := int64(8); left >= half; left >>= 1 {
+               if size > left {
+                       for right := int64(1); right <= 8; right <<= 1 {
+                               if left+right >= size {
+                                       result := left
+                                       if returnRight {
+                                               result = right
+                                       }
+                                       switch result {
+                                       case 1:
+                                               return typ.UInt8
+                                       case 2:
+                                               return typ.UInt16
+                                       case 4:
+                                               return typ.UInt32
+                                       case 8:
+                                               return typ.UInt64
+                                       default:
+                                               panic("unexpected chunk")
+                                       }
+                               }
+                       }
+                       panic("expected to find right chunk")
+               }
+       }
+       return nil
+}

